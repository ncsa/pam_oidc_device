---
# Toolchain-stability pins: keep the gate green across clang-tidy version bumps
# on the CI runner without masking real defects. Rationale:
#   - -readability-function-size: a subjective style metric; the device-flow
#     orchestrator (http_request) is large by nature, not a defect.
#   - -clang-analyzer-security.ArrayBound: emits false positives on this
#     codebase for the canonical isspace((unsigned char)x) idiom and for
#     calloc(n+1) NUL-termination — both provably in bounds at runtime.
# See .agents/memory.md for the full decision record.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-else-after-return,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.ArrayBound,
  -cert-err33-c
WarningsAsErrors: '*'
HeaderFilterRegex: 'include/.*'
